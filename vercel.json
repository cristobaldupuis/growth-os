{
  "functions": {
    "api/proxy.js": {
      "memory": 128,
      "maxDuration": 60
    },
    "api/image.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/video.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/admin.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/asset.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/debate.js": {
      "memory": 256,
      "maxDuration": 60
    },
    "api/state.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/mcp.js": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/oauth.js": {
      "memory": 128,
      "maxDuration": 15
    },
    "api/voice.js": {
      "memory": 128,
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/api/scene",
      "destination": "/api/video?kind=scene"
    },
    {
      "source": "/api/routing",
      "destination": "/api/state?action=routing"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/oauth?action=well-known-as"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/oauth?action=well-known-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/api/mcp",
      "destination": "/api/oauth?action=well-known-resource"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/((?!api/).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "script-src 'self' 'sha256-m5EbOxee8yIcJz14dP1Oik9VNC/7qAdFeRkWM9ULO2E=' 'unsafe-hashes' 'sha256-1jAmyYXcRq6zFldLe/GCgIDJBiOONdXjTLgEFMDnDSM='; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
